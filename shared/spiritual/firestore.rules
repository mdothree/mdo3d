rules_version = '2';
// Firebase project: oracle-mdo3d (shared by the 9 MDO3D divination apps).
// Deploy: cd shared/spiritual && firebase deploy --only firestore:rules
//
// Nothing in the apps writes to Firestore today: Firebase is optional and off by
// default in every public/js/config/firebase.js. These rules are deny-by-default
// and owner-scoped so it is safe to turn on later.
// Paid status is never stored in a client-writable doc. Premium content is
// unlocked only by the APIs after server-side Stripe verification.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUid(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsExisting() { return signedIn() && resource.data.uid == request.auth.uid; }
    function isHistory(c) {
      return c in ['oracle_readings', 'tarot_readings', 'dreams_readings', 'astrology_readings',
                   'fengshui_readings', 'iching_readings', 'runes_readings', 'pastlife_readings',
                   'numerology_readings', 'history'];
    }
    // New reading/history doc: owned by the caller, server timestamp, bounded size.
    function validNewOwned() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.size() <= 40;
    }

    // Profile/status docs: clients may read their own, but only the admin SDK
    // (server) may write. A client-writable "isPremium" flag must never exist.
    match /users/{userId} {
      allow read: if isUid(userId);
      allow write: if false;
    }

    // Per-app reading history: {app}_readings, owner-scoped, immutable once written.
    match /{collectionId}/{readingId} {
      allow read: if isHistory(collectionId) && ownsExisting();
      allow create: if isHistory(collectionId) && validNewOwned();
      allow update: if false;
      allow delete: if isHistory(collectionId) && collectionId != 'history' && ownsExisting();
    }

    // Server-authoritative premium entitlements (written by the Stripe webhook /
    // admin SDK only; clients may read their own).
    match /entitlements/{uid} {
      allow read:  if isUid(uid);
      allow write: if false;
    }

    // Everything else is denied (Firestore also denies unmatched paths by default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
