rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: the mdo3d-leads Firebase project is shared by two apps —
    //   • ronnascanner leads/CRM tools (owner-scoped: users, leads, contacts, companies)
    //   • resume-analyzer (anonymous capture: leads email, analytics events)
    // These rules union both so neither breaks.

    // Users collection - users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // leads: anonymous email capture (resume-analyzer) OR owner CRM record (ronnascanner)
    match /leads/{leadId} {
      allow create: if (request.resource.data.keys().hasOnly(['email','score','timestamp','source'])
                        && request.resource.data.email is string
                        && request.resource.data.email.size() < 254)
                    || (request.auth != null && request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // analytics: anonymous, write-only telemetry (resume-analyzer)
    match /analytics/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Contacts collection (owner-scoped CRM)
    match /contacts/{contactId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Companies collection (owner-scoped CRM)
    match /companies/{companyId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Analyses + payments (resume-analyzer: owner-scoped / server-only)
    match /analyses/{analysisId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if false; // backend only
    }

    // Default deny — anything not matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
