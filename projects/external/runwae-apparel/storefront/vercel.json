{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node src/build.mjs --brand $BRAND --out public $BUILD_FLAGS",
  "outputDirectory": "public",
  "functions": {
    "api/checkout.mjs": {
      "includeFiles": "{brands/**/*.json,inventory/*.csv}"
    },
    "api/availability.mjs": {
      "includeFiles": "{brands/**/*.json,inventory/*.csv}"
    },
    "api/stripe-webhook.mjs": {
      "includeFiles": "{brands/**/*.json,inventory/*.csv}"
    },
    "api/notify.mjs": {
      "maxDuration": 10
    },
    "api/order-lookup.mjs": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shop/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/shop/:path*",
      "has": [
        {
          "type": "host",
          "value": "store.buttsstudios.com"
        }
      ],
      "destination": "https://buttsstudios.com/shop/:path*",
      "statusCode": 301
    },
    {
      "source": "/shop",
      "has": [
        {
          "type": "host",
          "value": "store.buttsstudios.com"
        }
      ],
      "destination": "https://buttsstudios.com/shop/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api/|api$|shop/|shop$).*)",
      "has": [
        {
          "type": "host",
          "value": "store.buttsstudios.com"
        }
      ],
      "destination": "https://buttsstudios.com/shop/:path",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "shop-buttsstudios.vercel.app"
        }
      ],
      "destination": "/shop/",
      "statusCode": 307
    },
    {
      "source": "/shop/:path*",
      "has": [
        {
          "type": "host",
          "value": "store.ridgefieldtech.com"
        }
      ],
      "destination": "https://ridgefieldtech.com/shop/:path*",
      "statusCode": 301
    },
    {
      "source": "/shop",
      "has": [
        {
          "type": "host",
          "value": "store.ridgefieldtech.com"
        }
      ],
      "destination": "https://ridgefieldtech.com/shop/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api/|api$|shop/|shop$).*)",
      "has": [
        {
          "type": "host",
          "value": "store.ridgefieldtech.com"
        }
      ],
      "destination": "https://ridgefieldtech.com/shop/:path",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "shop-ridgefield.vercel.app"
        }
      ],
      "destination": "/shop/",
      "statusCode": 307
    }
  ]
}
