{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node src/build.mjs --brand $BRAND --out public",
  "outputDirectory": "public",
  "functions": {
    "api/checkout.mjs": {
      "includeFiles": "brands/**/*.json"
    },
    "api/notify.mjs": {},
    "api/order-lookup.mjs": {}
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ]
}
