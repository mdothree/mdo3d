# FL Sunbiz Lead Generator Crontab
0 8 * * 1 cd "$HOME/mdo3d/projects/leads/src" && "$HOME/mdo3d/projects/leads/.venv/bin/python" "$HOME/mdo3d/projects/leads/src/runner.py" --profile signals_institute >> "$HOME/mdo3d/projects/leads/logs/signals_institute.log" 2>&1 # mdo3d-leads:signals_institute
0 8 * * 1-5 cd "$HOME/mdo3d/projects/leads/src" && "$HOME/mdo3d/projects/leads/.venv/bin/python" "$HOME/mdo3d/projects/leads/src/runner.py" --profile ridgefield >> "$HOME/mdo3d/projects/leads/logs/ridgefield.log" 2>&1 # mdo3d-leads:ridgefield
0 8 * * 3 cd "$HOME/mdo3d/projects/leads/src" && "$HOME/mdo3d/projects/leads/.venv/bin/python" "$HOME/mdo3d/projects/leads/src/runner.py" --profile huntington_applied >> "$HOME/mdo3d/projects/leads/logs/huntington_applied.log" 2>&1 # mdo3d-leads:huntington_applied
0 8 * * 1 cd "$HOME/mdo3d/projects/leads/src" && "$HOME/mdo3d/projects/leads/.venv/bin/python" "$HOME/mdo3d/projects/leads/src/runner.py" --profile nonprofits_general >> "$HOME/mdo3d/projects/leads/logs/nonprofits_general.log" 2>&1 # mdo3d-leads:nonprofits_general
