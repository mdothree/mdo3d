# Leads scheduler (supercronic). Times are America/New_York.
CRON_TZ=America/New_York

# Daily ingest of every configured state ($LEADS_INGEST_STATES, e.g. FL,CO) into /data/leads.db.
# --lookback 3 re-fetches the last 3 days too: late-posted files are picked up, upserts dedupe.
15 9 * * * /app/ops/scheduler/ingest.sh
# Evening pass: FL posts some daily files late in the day.
15 21 * * * /app/ops/scheduler/ingest.sh

# Nightly SQLite .backup copy to the backups volume (keeps $LEADS_BACKUP_KEEP, default 14).
30 3 * * * /app/ops/scheduler/backup_db.sh

# Profile delivery (emails CSVs to paid profiles). OFF unless LEADS_ENABLE_DELIVERY=1:
# outbound email needs the Principal's OK.
0 8 * * * /app/ops/scheduler/run_delivery.sh
