{
  "name": "mdothree-landing",
  "version": "1.0.0",
  "description": "Hub landing page for mdothree.com utilities",
  "scripts": {
    "dev": "node scripts/inject-config.js && node scripts/stamp-versions.mjs && npx serve public",
    "build": "node scripts/inject-config.js && node scripts/stamp-versions.mjs",
    "stamp": "node scripts/stamp-versions.mjs",
    "start": "npx serve public",
    "check": "node scripts/check-imports.mjs public/js && node scripts/stamp-versions.mjs --check"
  },
  "devDependencies": {
    "serve": "^14.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "stripe": "^21.0.1"
  }
}
